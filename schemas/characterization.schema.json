{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Process cluster characterization",
  "description": "A description of a cluster that already exists. Carries no duration, amount or headcount: those are computed by deterministic code from measured counts. See observe/llm/schema_guard.py.",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "what_happens", "where_it_stalls", "why_it_recurs", "automation_opportunity", "artifact_recommendation", "coherence", "key_evidence_uids"],
  "properties": {
    "title": { "type": "string", "minLength": 8, "maxLength": 90 },
    "what_happens": { "type": "string", "minLength": 80, "maxLength": 1200 },
    "where_it_stalls": { "type": "string", "minLength": 40, "maxLength": 800 },
    "why_it_recurs": { "type": "string", "minLength": 20, "maxLength": 500 },
    "automation_opportunity": { "type": "string", "minLength": 30, "maxLength": 700 },
    "artifact_recommendation": {
      "type": "string",
      "enum": ["sop", "checklist", "runbook", "template", "email", "worksheet", "none"]
    },
    "coherence": { "type": "string", "enum": ["tight", "mixed", "incoherent"] },
    "key_evidence_uids": {
      "type": "array", "minItems": 0, "maxItems": 8,
      "items": { "type": "string" }
    }
  }
}
